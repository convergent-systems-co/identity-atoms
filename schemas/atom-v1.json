{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identity-atoms.com/schemas/atom-v1.json",
  "title": "identity-atoms v1 atom",
  "description": "A single atom in the identity-atoms catalog. Discriminated by the top-level `type` field; one of: auth-method, claim-type, trust-framework, key-cert-type.",
  "type": "object",
  "required": ["schema", "type", "id", "version", "name"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://identity-atoms.com/schemas/atom-v1.json"
    },
    "type": {
      "type": "string",
      "enum": [
        "auth-method",
        "claim-type",
        "trust-framework",
        "key-cert-type"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "description": "URL-safe slug; unique within the atom's type."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "algorithm": {
      "type": "string",
      "description": "Cryptographic or auth algorithm identifier (e.g. oauth2, ecdsa-p256, rsa-4096). Applicable to auth-method and key-cert-type atoms."
    },
    "trust_level": {
      "type": "string",
      "enum": ["any", "authenticated", "signed", "verified"],
      "description": "Trust level this atom asserts or requires."
    },
    "issuer": {
      "type": "string",
      "description": "Authority or domain that issues this auth method, claim, or key/cert. E.g. github.com, auth0.com."
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "maxLength": 200 }
        }
      },
      "description": "Structured claim descriptors for claim-type atoms."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 40 },
      "uniqueItems": true
    }
  }
}
